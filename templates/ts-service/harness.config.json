{
  "sensors": [
    {
      "name": "types",
      "kind": "command",
      "command": "npx tsc --noEmit",
      "parser": "tsc",
      "stages": ["post-edit", "pre-commit", "ci"]
    },
    {
      "name": "lint",
      "kind": "command",
      "command": "npx eslint . --format json",
      "parser": "eslint",
      "stages": ["post-edit", "pre-commit", "ci"],
      "fixHint": "Fix the rule violation; do not disable the rule."
    },
    {
      "name": "tests",
      "kind": "command",
      "command": "npm test --silent",
      "parser": "generic",
      "stages": ["pre-commit", "ci"],
      "fixHint": "Make the failing test pass by fixing the code, not by weakening the test."
    },
    {
      "name": "architecture",
      "kind": "command",
      "command": "npx depcruise src --config .dependency-cruiser.cjs",
      "parser": "generic",
      "stages": ["pre-commit", "ci"],
      "fixHint": "Respect module boundaries in .dependency-cruiser.cjs; move code rather than adding a forbidden import."
    },
    {
      "name": "review",
      "kind": "review",
      "skill": "skills/code-review/SKILL.md",
      "stages": ["ci"],
      "optional": true
    }
  ],
  "review": { "command": "claude", "argsTemplate": ["-p", "{prompt}"] },
  "guides": { "canonical": "AGENTS.md", "skillsDir": "skills" },
  "report": { "maxChars": 6000 }
}
